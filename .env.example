# Base URL of the ParcelFlow API. No trailing slash, no path.
#
# Vite inlines VITE_* at BUILD time, not run time, so changing this on Vercel
# requires a redeploy — saving the variable alone does nothing.
VITE_API_BASE_URL=https://parcelflowapi.onrender.com

# Escape hatch, if client-side blockers ever start blocking more than the two
# /health paths (see README > Client-side blocking). vercel.json already
# rewrites /api/* to the Render service, so switching is just this value plus a
# redeploy. Cost: the API then sees Vercel's edge IP, so its per-IP rate limits
# become shared across all visitors.
#   VITE_API_BASE_URL=/api
